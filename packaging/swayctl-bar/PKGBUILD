# Maintainer: huyhappy <nguyentanhuy.work@gmail.com>
# The bar, Quick Settings and OSD for swayctl-center (Desktop > Bar > Bar program).
pkgname=swayctl-bar
pkgver=0.1.0
pkgrel=16
pkgdesc="GPU-rendered bar with Quick Settings, notifications and OSD, and a lock screen with fingerprint unlock, for swayctl-center"
arch=(x86_64)
url="https://github.com/huyhappy/swayctl-center"
license=(MIT)
depends=(gtk4 libadwaita gtk4-layer-shell pam)
provides=(notification-daemon)
makedepends=(cargo)
optdepends=('networkmanager: Wi-Fi tile and network list'
            'bluez: Bluetooth tile'
            'upower: battery'
            'power-profiles-daemon: Power Mode tile'
            'libpulse: volume (pactl; works with PipeWire via pipewire-pulse)'
            'brightnessctl: brightness slider and OSD'
            'swaync: Do Not Disturb tile'
            'fprintd: fingerprint unlock in swayctl-lock')
source=()

_srcroot="$startdir/../../swayctl-bar"

build() {
  cd "$_srcroot"
  cargo build --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/swayctl-bar" "$pkgdir/usr/bin/swayctl-bar"
  install -Dm755 "$srcdir/target/release/swayctl-lock" "$pkgdir/usr/bin/swayctl-lock"
}
